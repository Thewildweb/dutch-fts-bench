# Copy to .env and adjust. Never commit .env.
DATASET_PATH=data/rje-jobs-2026-09.parquet
DATASET_SHA256=eaf96c29fea94e96c9acb658f40aa736fca037e1525a5407840fe18db717a57d

# Same limits for every engine; benchmark one engine at a time.
BENCH_CPUS=8
BENCH_MEM=16g

PG_IMAGE=paradedb/paradedb:latest-pg17
PG_PORT=5432
PG_SHARED_BUFFERS=4GB
PG_DSN=postgresql://bench:bench@127.0.0.1:5432/bench

ES_VERSION=9.1.0
ES_PORT=9200
ES_HEAP=8g
ES_URL=http://127.0.0.1:9200

# OpenAI-compatible endpoint used as relevance grader.
JUDGE_URL=http://127.0.0.1:8000/v1
JUDGE_MODEL=gemma
